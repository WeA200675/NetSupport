<Window x:Class="NetSupport.RemoteAdmin.Views.RdpSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="RDP Session"
        Width="1280"
        Height="880"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TargetTextBlock" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,3,0,0" Opacity="0.65" Text="Nicht verbunden"/>
                    <TextBlock x:Name="SessionDetailTextBlock" Margin="0,3,0,0" Opacity="0.55" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyDetailsButton" Content="Details kopieren" Padding="12,6" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="CopyDetailsButton_OnClick"/>
                    <Button x:Name="ReconnectButton" Content="Neu verbinden" Padding="14,6" Margin="0,0,8,0"
                            Click="ReconnectButton_OnClick"/>
                    <Button x:Name="FullscreenButton" Content="Vollbild" Padding="14,6" Margin="0,0,8,0"
                            Click="FullscreenButton_OnClick"/>
                    <Button Content="Trennen" Padding="14,6"
                            Click="DisconnectButton_OnClick"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Benutzer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="UserNameTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                             Padding="8,0" ToolTip="Optional: Benutzername oder DOMÄNE\Benutzer"/>

                    <TextBlock Grid.Column="2" Text="Domäne" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="DomainTextBox" Grid.Column="3" Height="30" VerticalContentAlignment="Center"
                             Padding="8,0" ToolTip="Optional: Windows-/AD-Domäne"/>

                    <CheckBox x:Name="SmartSizingCheckBox" Grid.Column="4" Content="An Fenster anpassen"
                              IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                              Checked="SmartSizingCheckBox_OnChanged" Unchecked="SmartSizingCheckBox_OnChanged"/>

                    <TextBlock Grid.Column="5" Text="Kennwort wird vom Windows-RDP-Dialog abgefragt und nicht von dieser Anwendung gespeichert."
                               VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="16,0,0,0"/>
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ClipboardCheckBox" Content="Zwischenablage" IsChecked="True"
                              VerticalAlignment="Center" ToolTip="Wird bei der nächsten Verbindung angewendet."/>
                    <CheckBox x:Name="AdminSessionCheckBox" Grid.Column="1" Content="Admin-Sitzung"
                              VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="Administrative RDP-Sitzung; wird bei der nächsten Verbindung angewendet."/>
                    <CheckBox x:Name="MultiMonitorCheckBox" Grid.Column="2" Content="Mehrere Monitore"
                              VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="Verwendet alle lokalen Monitore; wird bei der nächsten Verbindung angewendet."/>

                    <Button Grid.Column="3" Content="Alt+Tab remote" Padding="12,5" Margin="22,0,0,0"
                            Click="AppSwitchButton_OnClick"/>
                    <Button Grid.Column="4" Content="Start remote" Padding="12,5" Margin="8,0,0,0"
                            Click="StartScreenButton_OnClick"/>
                    <Button Grid.Column="5" Content="Action Center" Padding="12,5" Margin="8,0,0,0"
                            Click="ActionCenterButton_OnClick"/>
                    <Button Grid.Column="6" Content="Task-Manager" Padding="12,5" Margin="8,0,0,0"
                            Click="TaskManagerButton_OnClick"/>

                    <TextBlock Grid.Column="7" Text="Optionen werden beim Neuverbinden übernommen. Remote-Aktionen benötigen eine aktive Sitzung; Task-Manager hängt von der Windows-Version ab."
                               VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="16,0,0,0"/>
                </Grid>

                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Audio" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="AudioModeComboBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" ToolTip="Wird bei der nächsten Verbindung angewendet."/>
                    <CheckBox x:Name="DriveRedirectionCheckBox" Grid.Column="2" Content="Laufwerke"
                              VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="Leitet lokale Laufwerke in die Remotesitzung um; wird bei der nächsten Verbindung angewendet."/>
                    <CheckBox x:Name="MicrophoneRedirectionCheckBox" Grid.Column="3" Content="Mikrofon"
                              VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="Leitet das lokale Standardmikrofon in die Remotesitzung um; wird bei der nächsten Verbindung angewendet."/>
                    <TextBlock Grid.Column="4" Text="Laufwerksumleitung ist aus Sicherheitsgründen standardmäßig aus. Audio/Mikrofon werden erst beim Neuverbinden angewendet."
                               VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="16,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Border Background="#111">
            <wfi:WindowsFormsHost x:Name="RdpHost"/>
        </Border>
    </DockPanel>
</Window>
