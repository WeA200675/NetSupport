<Window x:Class="NetSupport.RemoteAdmin.Views.NetSupportDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSupport prüfen" Height="520" Width="820"
        MinHeight="430" MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="NetSupport-Installation prüfen" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Lokale Erkennung von PCICTLUI.EXE und Versionsinformationen – ohne Netzwerkzugriff oder Remoteverbindung."
                       TextWrapping="Wrap" Opacity="0.65" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="10" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Aktuell konfiguriert" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConfiguredPathTextBlock" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="CandidatesListBox" Grid.Row="2" SelectionChanged="CandidatesListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="2,3" BorderBrush="#22000000" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="11" Opacity="0.65" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap" Opacity="0.7" Margin="8,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ProductName}" FontSize="11" Opacity="0.7" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding CompanyName}" FontSize="11" Opacity="0.55"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Schließen" Width="105" Height="34" DockPanel.Dock="Right" IsCancel="True"/>
            <Button x:Name="UseSelectedButton" Content="Pfad übernehmen" Width="130" Height="34" Margin="0,0,8,0"
                    DockPanel.Dock="Right" IsEnabled="False" Click="UseSelectedButton_OnClick"/>
            <Button Content="Neu prüfen" Width="105" Height="34" DockPanel.Dock="Left" Click="RefreshButton_OnClick"/>
        </DockPanel>
    </Grid>
</Window>
