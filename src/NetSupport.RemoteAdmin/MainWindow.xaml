<Window x:Class="NetSupport.RemoteAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin" Height="760" Width="1120"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Remote Admin" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Schneller Zugriff auf NetSupport und Domänenrechner" Opacity="0.65" Margin="0,4,0,4"/>
            <TextBlock Text="Domänenrichtlinie: Remotezugriff erfolgt ausschließlich über NetSupport Manager. RDP wird von dieser Anwendung nicht angeboten."
                       Opacity="0.62" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HostTextBox" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                     ToolTip="Rechnername oder IP-Adresse" KeyDown="HostTextBox_OnKeyDown"/>
            <Button Grid.Column="1" x:Name="ConnectButton" Content="Verbinden" Width="115" Height="36" Margin="10,0,0,0"
                    IsDefault="True" Click="ConnectButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterTextBox" Height="32" VerticalContentAlignment="Center" Padding="9,0"
                     ToolTip="Name, Host, Beschreibung oder Gruppe filtern" TextChanged="FilterTextBox_OnTextChanged"/>
            <ComboBox x:Name="GroupFilterComboBox" Grid.Column="1" Height="32" Margin="8,0,0,0"
                      VerticalContentAlignment="Center" ToolTip="Rechnergruppe filtern"
                      SelectionChanged="GroupFilterComboBox_OnSelectionChanged"/>
            <CheckBox x:Name="FavoritesOnlyCheckBox" Grid.Column="2" Content="Nur Favoriten" Margin="12,0,4,0"
                      VerticalAlignment="Center" Checked="FavoritesOnlyCheckBox_OnChanged" Unchecked="FavoritesOnlyCheckBox_OnChanged"/>
            <Button Grid.Column="3" x:Name="LoadDomainButton" Content="Domäne laden" Height="32" Width="120" Margin="8,0,0,0"
                    Click="LoadDomainButton_OnClick"/>
            <Button Grid.Column="4" x:Name="RefreshStatusButton" Content="Status prüfen" Height="32" Width="120" Margin="8,0,0,0"
                    Click="RefreshStatusButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ansicht" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox x:Name="SavedViewComboBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" VerticalContentAlignment="Center"
                      ToolTip="Gespeicherte Filteransicht auswählen oder einen neuen Namen eingeben"
                      SelectionChanged="SavedViewComboBox_OnSelectionChanged"/>
            <Button Grid.Column="2" Content="Ansicht speichern" Height="30" Margin="8,0,0,0" Padding="12,0"
                    Click="SaveViewButton_OnClick"/>
            <Button Grid.Column="3" Content="Ansicht löschen" Height="30" Margin="8,0,0,0" Padding="12,0"
                    Click="DeleteViewButton_OnClick"/>
            <TextBlock Grid.Column="4" Text="Speichert Suchtext, Gruppe und Favoritenfilter." VerticalAlignment="Center"
                       Opacity="0.55" FontSize="11" Margin="12,0,0,0"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2.45*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Rechner" Margin="0,0,12,0">
                <ListBox x:Name="TargetsListBox" Margin="8"
                         SelectionChanged="TargetsListBox_OnSelectionChanged"
                         MouseDoubleClick="TargetsListBox_OnMouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FavoriteMarker}" FontSize="15" VerticalAlignment="Top" Margin="0,0,7,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Host}" Opacity="0.65" FontSize="11"/>
                                    <TextBlock Text="{Binding Group}" Opacity="0.62" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12" BorderThickness="1" CornerRadius="4" BorderBrush="#33000000">
                        <StackPanel>
                            <TextBlock Text="Ausgewählter Rechner" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedTargetNameTextBlock" Text="Kein Rechner ausgewählt" FontSize="18" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SelectedTargetHostTextBlock" Opacity="0.65" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SelectedTargetStatusTextBlock" Opacity="0.75" Margin="0,4,0,0"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Favorit" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FavoriteCheckBox" Grid.Column="1" Content="Bevorzugt anzeigen" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="Gruppe" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,7,0,0"/>
                                <TextBox x:Name="TargetGroupTextBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,7,0,0"
                                         Padding="7,0" VerticalContentAlignment="Center" ToolTip="Zum Beispiel Büro, Werkstatt, Server"/>

                                <TextBlock Grid.Row="2" Text="Standard" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,7,0,0"/>
                                <ComboBox x:Name="PreferredProviderComboBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,7,0,0"
                                          DisplayMemberPath="DisplayName" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Button x:Name="StandardConnectButton" Content="Standardverbindung starten" Height="32" Margin="0,10,0,0"
                                    Click="StandardConnectButton_OnClick"/>

                            <Separator Margin="0,10,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="IP" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetIpTextBlock" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Text="Benutzer" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetUserTextBlock" Grid.Row="1" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Text="System" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetOsTextBlock" Grid.Row="2" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Text="Modell" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetModelTextBlock" Grid.Row="3" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Text="Geprüft" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetLastCheckTextBlock" Grid.Row="4" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>

                                <TextBlock Grid.Row="5" Text="Letzter Start" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock x:Name="SelectedTargetLastSessionTextBlock" Grid.Row="5" Grid.Column="1" Text="–" TextWrapping="Wrap" Margin="0,2"/>
                            </Grid>

                            <TextBlock x:Name="SelectedTargetDetailsErrorTextBlock" Margin="0,7,0,0" Opacity="0.6"
                                       FontSize="11" TextWrapping="Wrap"/>
                            <Button x:Name="RefreshDetailsButton" Content="Rechnerdetails laden" Height="32" Margin="0,10,0,0"
                                    Click="RefreshDetailsButton_OnClick"/>
                            <Button x:Name="TargetDiagnosticsButton" Content="Verbindung diagnostizieren" Height="32" Margin="0,7,0,0"
                                    ToolTip="Prüft DNS, Ping und den konfigurierten NetSupport-Client-Port ohne Remote-Sitzung"
                                    Click="TargetDiagnosticsButton_OnClick"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Schnellaktionen" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Steuern" Tag="netsupport|Control" Height="42" Margin="0,0,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Nur ansehen" Tag="netsupport|View" Height="42" Margin="6,0,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Remote CMD" Tag="netsupport|CommandPrompt" Height="42" Margin="0,6,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Dateien" Tag="netsupport|FileTransfer" Height="42" Margin="6,6,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Inventar" Tag="netsupport|Inventory" Height="42" Margin="0,6,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Chat" Tag="netsupport|Chat" Height="42" Margin="6,6,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Speichern / Aktualisieren" Height="42" Margin="0,6,6,0" Click="SaveTargetButton_OnClick"/>
                        <Button Content="Einstellungen" Height="42" Margin="6,6,0,0" Click="OpenSettingsButton_OnClick"/>
                    </UniformGrid>

                    <Expander Header="Zuletzt verwendet" Margin="0,18,0,0" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                            <ListBox x:Name="HistoryListBox" Height="165" MouseDoubleClick="HistoryListBox_OnMouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4" ToolTip="{Binding Error}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusMarker}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Opacity="0.65" FontSize="11"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProviderActionText}" Opacity="0.62" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <Button Content="Aktualisieren" Height="30" Margin="0,0,4,0" Click="RefreshHistoryButton_OnClick"/>
                                <Button Content="CSV exportieren" Height="30" Margin="4,0,4,0" Click="ExportHistoryButton_OnClick"/>
                                <Button Content="Löschen" Height="30" Margin="4,0,0,0" Click="ClearHistoryButton_OnClick"/>
                            </UniformGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Erweitert" Margin="0,18,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Provider" FontWeight="SemiBold" Margin="0,2,0,6"/>
                            <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_OnSelectionChanged"/>

                            <TextBlock Text="Aktion" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <ComboBox x:Name="ActionComboBox" Height="32"/>

                            <TextBlock Text="Gemäß Domänenrichtlinie wird nur NetSupport als Remote-Provider registriert."
                                       Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button Content="Konfigurationsordner" Height="32" Margin="0,12,0,0" Click="OpenConfigButton_OnClick"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="5" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
