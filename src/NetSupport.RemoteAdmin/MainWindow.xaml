<Window x:Class="NetSupport.RemoteAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin" Height="430" Width="720"
        MinHeight="390" MinWidth="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Remote Admin" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="NetSupport und weitere Remote-Backends über eine Oberfläche" Opacity="0.65" Margin="0,4,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HostTextBox" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                     ToolTip="Rechnername oder IP-Adresse" KeyDown="HostTextBox_OnKeyDown"/>
            <Button Grid.Column="1" x:Name="ConnectButton" Content="Verbinden" Width="115" Height="36" Margin="10,0,0,0"
                    IsDefault="True" Click="ConnectButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Gespeicherte Rechner" Margin="0,0,12,0">
                <ListBox x:Name="TargetsListBox" Margin="8" MouseDoubleClick="TargetsListBox_OnMouseDoubleClick"/>
            </GroupBox>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Verbindung" FontWeight="SemiBold" Margin="0,2,0,6"/>
                <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_OnSelectionChanged"/>

                <TextBlock Text="Aktion" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ComboBox x:Name="ActionComboBox" Height="32"/>

                <Button Content="Rechner speichern" Height="32" Margin="0,18,0,0" Click="SaveTargetButton_OnClick"/>
                <Button Content="Konfigurationsordner öffnen" Height="32" Margin="0,8,0,0" Click="OpenConfigButton_OnClick"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
