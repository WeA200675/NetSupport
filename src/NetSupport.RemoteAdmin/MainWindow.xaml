<Window x:Class="NetSupport.RemoteAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin" Height="620" Width="980"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Remote Admin" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Schneller Zugriff auf NetSupport, RDP und Domänenrechner" Opacity="0.65" Margin="0,4,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HostTextBox" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                     ToolTip="Rechnername oder IP-Adresse" KeyDown="HostTextBox_OnKeyDown"/>
            <Button Grid.Column="1" x:Name="ConnectButton" Content="Verbinden" Width="115" Height="36" Margin="10,0,0,0"
                    IsDefault="True" Click="ConnectButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterTextBox" Height="32" VerticalContentAlignment="Center" Padding="9,0"
                     ToolTip="Rechner filtern" TextChanged="FilterTextBox_OnTextChanged"/>
            <Button Grid.Column="1" x:Name="LoadDomainButton" Content="Domäne laden" Height="32" Width="120" Margin="8,0,0,0"
                    Click="LoadDomainButton_OnClick"/>
            <Button Grid.Column="2" x:Name="RefreshStatusButton" Content="Status prüfen" Height="32" Width="120" Margin="8,0,0,0"
                    Click="RefreshStatusButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2.15*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Rechner" Margin="0,0,12,0">
                <ListBox x:Name="TargetsListBox" Margin="8"
                         SelectionChanged="TargetsListBox_OnSelectionChanged"
                         MouseDoubleClick="TargetsListBox_OnMouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Host}" Opacity="0.65" FontSize="11"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12" BorderThickness="1" CornerRadius="4" BorderBrush="#33000000">
                        <StackPanel>
                            <TextBlock Text="Ausgewählter Rechner" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedTargetNameTextBlock" Text="Kein Rechner ausgewählt" FontSize="18" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SelectedTargetHostTextBlock" Opacity="0.65" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SelectedTargetStatusTextBlock" Opacity="0.75" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Schnellaktionen" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Steuern" Tag="netsupport|Control" Height="42" Margin="0,0,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Nur ansehen" Tag="netsupport|View" Height="42" Margin="6,0,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="RDP" Tag="rdp|Control" Height="42" Margin="0,6,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Remote CMD" Tag="netsupport|CommandPrompt" Height="42" Margin="6,6,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Dateien" Tag="netsupport|FileTransfer" Height="42" Margin="0,6,6,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Inventar" Tag="netsupport|Inventory" Height="42" Margin="6,6,0,6" Click="QuickActionButton_OnClick"/>
                        <Button Content="Chat" Tag="netsupport|Chat" Height="42" Margin="0,6,6,0" Click="QuickActionButton_OnClick"/>
                        <Button Content="Speichern" Height="42" Margin="6,6,0,0" Click="SaveTargetButton_OnClick"/>
                    </UniformGrid>

                    <Expander Header="Erweitert" Margin="0,18,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Provider" FontWeight="SemiBold" Margin="0,2,0,6"/>
                            <ComboBox x:Name="ProviderComboBox" Height="32" SelectionChanged="ProviderComboBox_OnSelectionChanged"/>

                            <TextBlock Text="Aktion" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <ComboBox x:Name="ActionComboBox" Height="32"/>

                            <Button Content="Konfigurationsordner öffnen" Height="32" Margin="0,12,0,0" Click="OpenConfigButton_OnClick"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="4" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
